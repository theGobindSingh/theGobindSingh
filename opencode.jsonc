{
  "$schema": "https://opencode.ai/config.json",

  // Auto-format with prettier on write (migrated from .claude PostToolUse hook)
  "formatter": true,

  // Load project docs as instructions (alongside AGENTS.md which is read automatically)
  "instructions": [
    "docs/PRODUCT.md",
    "docs/DESIGN.md",
    "docs/CONVENTIONS.md",
  ],

  // Block .env edits (migrated from .claude PreToolUse hook; reads are already denied by default)
  "permission": {
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      ".env.example": "allow",
    },
  },

  // Subagents ported from .claude/agents/ — prompts reference existing files
  "agent": {
    "seo-reviewer": {
      "description": "Reviews new pages and copy changes for SEO completeness. Spawn when adding pages or updating metadata.",
      "mode": "subagent",
      "prompt": "{file:.claude/agents/seo-reviewer.md}",
      "permission": { "edit": "deny", "bash": "deny" },
    },
    "ui-reviewer": {
      "description": "Reviews UI/component changes for accessibility, responsive layout, and Tailwind correctness. Spawn when editing components or CSS.",
      "mode": "subagent",
      "prompt": "{file:.claude/agents/ui-reviewer.md}",
      "permission": { "edit": "deny", "bash": "deny" },
    },
  },

  "lsp": {},
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--isolated"],
      "enabled": true,
    },
  },
}
