PAYLOAD_SECRET=...
DATABASE_URL=postgresql://...
RESEND_API_KEY=...

# Domain / DNS tooling (local CLI use only; never read by the app)
# Vercel access token: https://vercel.com/account/tokens  (used by `vercel --token` / VERCEL_TOKEN)
VERCEL_TOKEN=vcp_...
# GoDaddy Personal Access Token: https://developer.godaddy.com/en/personal-access-token
# scopes: domains.domain:read, domains.dns:update  (used by the `gddy` CLI)
GDDY_PAT=gd_pat_...
